# Copy to .env.local and fill in. NEVER commit .env.local.
# Leave the two Supabase values empty to run in local DEMO MODE (sample data in your browser).

# Supabase project URL and anon (public) key — safe for the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: force demo mode even when Supabase values are present (true/false)
NEXT_PUBLIC_DEMO_MODE=

# The service-role key is NOT used by this app. Never add it to a NEXT_PUBLIC_ variable.
